<!DOCTYPE html>
<html lang="en">
<head>
    <style>
        body {
            background-image: url("background3.jpg");
            background-repeat: no-repeat;
            background-size: 100%;
        }

        h1 {
            color: white;
            text-align: center;
            -webkit-text-stroke: 1px blue;
        }
        .status-message {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            background-color: transparent;
            color: white;
            font-size: 1.5em;
            text-align: center;
            padding: 10px;
            z-index: 9999;
            pointer-events: none;
        }
    </style>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Want-to-Go List</title>
    <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
</head>
<body>
    <% if (status === 'exists' || status === 'added') { %>
        <div class="status-message">
            <% if (status === 'exists') { %>
                This destination was added before.
            <% } else if (status === 'added') { %>
                Destination added successfully!
            <% } %>
        </div>
    <% } %>
    

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-2">
          
        <a class="navbar-brand" style="color: rgb(191, 255, 161)">Want-to-Go List</a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent"
            aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav mr-auto">
            </ul>
            <form method="POST" action='/search' class="form-inline my-2 my-lg-0">
                <input class="form-control mr-sm-2" name="Search" type="search" placeholder="Search"
                    aria-label="Search">
                <button class="btn btn-outline-success my-2 my-sm-0" type="submit">Search</button>
            </form>
        </div>
    </nav>

    <div class="container">
        <h1>My Want-to-Go List</h1>
        <ul class="list-group mt-3">
            <% if (destinations.length === 0) { %>
                <li class="list-group-item">Your Want-to-Go List is empty!</li>
            <% } else { %>
                <% destinations.forEach(destination => { %>
                    <li class="list-group-item">
                        <strong><%= destination.name %></strong>
                        <p><%= destination.description %></p>
                    </li>
                <% }) %>
            <% } %>
        </ul>
        
        <a href="/" class="btn btn-secondary mt-3">Back to Home</a>
    </div>
</body>

</html>